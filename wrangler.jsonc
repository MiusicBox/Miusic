{
  "name": "miusic-store",
  "compatibility_date": "2024-09-23",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
    // 🆕 (T033): ลบ run_worker_first: ["/api/*"] — ปล่อยให้ CDN cache ทำงานก่อน Worker
    //   ปัญหา: run_worker_first บังคับให้ทุก /api/* request วิ่งไป Worker เสมอ → นับเป็น invocation
    //   แม้ Cache API (caches.default) จะคืน cached response แต่ Worker ยังรัน = นับ invocation
    //   วิธีแก้: ลบออก → CDN ตรวจ cache ก่อน → cache hit = ไม่ invoke Worker เลย
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "musicbox-store-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miusic-store-db",
      "database_id": "5638f1b9-48ca-40cb-9221-ed6910bcee8c"
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://pub-1c69acdb5ecc47469099f274456c724f.r2.dev"
    // 🧹 (T-sync-cleanup 2026-10-06): WORKER_URL comment ถูกลบออก — Sequential Queue rollback ใน T030
    //   ลบ code ที่อ่าน env.WORKER_URL แล้ว (cron self-invoke) แต่ลืมลบ comment นี้ → dead reference
    //   ผลกระทบระบบเดิม: 0% — เป็นแค่ comment ไม่มี code อ่าน env.WORKER_URL จริง
  },
  // 🔒 (2026-09-21 auto-cleanup ZIP): Cron Trigger — 🆕 (T030) เปลี่ยนเป็น 24 ชม.
  //   ค้นหา ZIP ที่สร้างเกิน 24 ชม. → ลบออกจาก R2 + update order zip_status='expired'
  //   กัน URL ถาวรรั่ว → ถ้ารั่ว ใช้ได้แค่ 24 ชม. แล้วหาย
  //   ดู handler ที่ worker/index.js → async scheduled(event, env, ctx)
  //   🆕 (T030): เปลี่ยนจาก 6 ชม. → 24 ชม. — ลด cron invocations จาก 4/วัน → 1/วัน
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  // 📊 (2026-09-28 enable logs): เปิด observability logs สำหรับ Worker
  //   ทำให้ Dashboard → Workers → miusic-store → Logs → แสดง log จริงได้
  //   รองรับ "Begin log stream" button + ดู console.log ทั้งหมด
  //   ผลกระทบระบบเดิม: 0% — เปิด log เท่านั้น ไม่เปลี่ยน logic
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

/robots.txt
  Content-Type: text/plain; charset=utf-8

/*.css
  Cache-Control: public, max-age=31536000
/*.js
  Cache-Control: no-cache
/*.svg
  Cache-Control: public, max-age=31536000

# 🆕 (T004-pwa): PWA asset cache rules
#   - manifest.json: no-cache เพื่อให้ลูกค้าเห็น manifest เวอร์ชั่นใหม่ทันทีหลัง deploy
#   - service-worker.js: no-cache เพื่อให้ browser detect SW update ทุกครั้ง
#     (browser byte-compares SW แล้ว skip update ถ้าเหมือนเดิม → bandwidth ไม่กระทบ)
#   - icon-*.png: 1 ปี immutable เพราะ icon เปลี่ยนนาทีละครั้ง + ใช้ชื่อไฟล์เดิม
#     หมายเหตุ: ถ้าเปลี่ยน icon จริง ๆ ต้อง bump CACHE_VERSION ใน service-worker.js
/manifest.json
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable


# 🔒 (2026-10-11) Security headers สำหรับหน้า HTML/ไฟล์ static (ฝั่ง API ตั้งไว้ใน worker แล้ว)
#   - ไม่ตั้ง X-Frame-Options ทั้งเว็บ เพราะต้องทดสอบหน้าร้านผ่านเครื่องมือ preview แบบ iframe
#   - หน้าแอดมินห้ามถูกฝังใน iframe (กัน clickjacking)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=()
/admin.html
  X-Frame-Options: DENY
  Cache-Control: no-cache
